<?xml version='1.0' encoding='utf-8'?>
<widget id="com.sararistore.pos" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Sari-Sari Store POS</name>
    <description>
        A Point of Sale system for Sari-Sari stores on mobile
    </description>
    <author email="annechervill@gmail.com" href="https://github.com/annechervill-hue">
        Anne Chervill
    </author>
    <content src="index.html" />
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <preference name="loglevel" value="log" />
    <preference name="orientation" value="portrait" />
    <preference name="fullscreen" value="true" />
</widget>